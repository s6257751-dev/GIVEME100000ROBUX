local function QKZXCWV_fake_script() -- TextButton.LocalScript 
	local script = Instance.new('LocalScript', TextButton)

	local button = script.Parent
	
	while true do
		-- Становится черным
		button.BackgroundColor3 = Color3.new(1, 0, 0)
		button.TextColor3 = Color3.new(0.0156863, 1, 0)
		wait(0.001) -- Пауза 0.5 секунды
	
		-- Становится белым
		button.BackgroundColor3 = Color3.new(0, 1, 0.14902)
		button.TextColor3 = Color3.new(0, 0.14902, 1)
		wait(0.001)
	end
end
coroutine.wrap(QKZXCWV_fake_script)()
